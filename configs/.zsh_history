: 1725360989:0;./memory.sh
: 1725361028:0;#!/bin/bash\
\
# Fetch all pods and their resource requests and limits, then compare with their actual usage\
kubectl get pods --all-namespaces -o json | jq -r '\
  .items[] | \
  .metadata.namespace as $namespace |\
  .metadata.name as $pod |\
  .spec.containers[] | \
  .name as $container | \
  .resources.requests.memory as $request |\
  .resources.limits.memory as $limit |\
  $namespace + " " + $pod + " " + $container + " " + ($request // "0Mi") + " " + ($limit // "0Mi")\
' | while read namespace pod container request limit; do\
  # Get the current memory usage of the container\
  usage=$(kubectl top pod $pod -n $namespace --containers | grep $container | awk '{print $4}')\
  \
  # Check if the container is using more memory than requested\
  if [[ $usage > $request ]]; then\
    echo "$namespace $pod $container $usage $request $limit"\
  fi\
done | sort -k4 -nr
: 1725361039:0;kubectl get pods --all-namespaces -o json | jq -r '
: 1725361050:0;kubectl get pods --all-namespaces -o json | jq -r 
: 1725361081:0;kubectl get pods --all-namespaces -o json | jq -r | while read namespace pod container request limit; do usage=$(kubectl top pod $pod -n $namespace --containers | grep $container | awk '{print $4}')
: 1725361093:0;kubectl get pods --all-namespaces -o json | jq -r | while read namespace pod container request limit; do usage=$(kubectl top pod $pod -n $namespace --containers | grep $container | awk '{print $4}') done
: 1725361124:0;kubectl get pods --all-namespaces -o json | jq -r | while read namespace pod container request limit; do usage=$(kubectl top pod $pod -n $namespace --containers | grep $container | awk '{print $4}') done | sort -k4 -nr
: 1725361188:0;#!/bin/bash\
\
# Fetch all pods and their resource requests and limits, then compare with their actual usage\
kubectl get pods --all-namespaces -o json | jq -r '\
  .items[] | \
  .metadata.namespace as $namespace |\
  .metadata.name as $pod |\
  .spec.containers[] | \
  .name as $container | \
  .resources.requests.memory as $request |\
  .resources.limits.memory as $limit |\
  $namespace + " " + $pod + " " + $container + " " + ($request // "0Mi") + " " + ($limit // "0Mi")\
' | while read namespace pod container request limit; do\
  # Get the current memory usage of the container\
  usage=$(kubectl top pod $pod -n $namespace --containers 2>/dev/null | grep $container | awk '{print $4}')\
\
  # Only proceed if usage data is available\
  if [[ -n $usage ]]; then\
    # Convert usage and request to a comparable format (Mi)\
    usage_value=$(echo $usage | sed 's/Mi//')\
    request_value=$(echo $request | sed 's/Mi//')\
\
    # Check if the container is using more memory than requested\
    if (( usage_value > request_value )); then\
      echo "$namespace $pod $container $usage $request $limit"\
    fi\
  fi\
done | sort -k4 -nr
